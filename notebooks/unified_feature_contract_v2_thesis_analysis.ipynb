    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# Unified Feature Contract v2 — Thesis Analysis Notebook\\n\",\n",
    "    \"\\n\",\n",
    "    \"**Experiment:** `unified_feature_contract_v2`  \\n\",\n",
    "    \"**Selected runtime candidate:** `unified_relative_shape_v2__lgbm`  \\n\",\n",
    "    \"**Notebook purpose:** Thesis-support analysis of the final unified feature contract experiment.\\n\",\n",
    "    \"\\n\",\n",
    "    \"This notebook *loads and summarizes* the experiment artifacts. It does **not** retrain or modify models.\\n\",\n",
    "    \"\\n\",\n",
    "    \"## ⚠️ Hard rules for this notebook\\n\",\n",
    "    \"\\n\",\n",
    "    \"- ❌ **Do not retrain** any model.\\n\",\n",
    "    \"- ❌ **Do not overwrite** any model artifact, calibrator, or threshold file.\\n\",\n",
    "    \"- ❌ **Do not modify thresholds**.\\n\",\n",
    "    \"- ❌ **Do not modify the prototype app** (frontend or backend).\\n\",\n",
    "    \"- ⚠️ **Missing metrics must be reported as missing, not invented.**\\n\",\n",
    "    \"- ⚠️ All numbers shown are read from existing CSV / JSON / MD files on disk.\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## A. Executive summary\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"import json, csv\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"from IPython.display import Markdown, Image, display\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Resolve PROJECT_ROOT robustly (works whether the notebook is executed from notebooks/ or the project root)\\n\",\n",
    "    \"_here = Path.cwd().resolve()\\n\",\n",
    "    \"_candidates = [_here, _here.parent, *_here.parents]\\n\",\n",
    "    \"PROJECT_ROOT = next((p for p in _candidates if (p / 'artifacts' / 'unified_feature_contract_v2').exists()), _here)\\n\",\n",
    "    \"EXP_DIR      = PROJECT_ROOT / 'artifacts' / 'unified_feature_contract_v2'\\n\",\n",
    "    \"RT_DIR       = EXP_DIR / 'runtime_export'\\n\",\n",
    "    \"FIG_DIR      = EXP_DIR / 'figures'\\n\",\n",
    "    \"THESIS_DIR   = EXP_DIR / 'thesis_exports'\\n\",\n",
    "    \"THESIS_DIR.mkdir(parents=True, exist_ok=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print('PROJECT_ROOT :', PROJECT_ROOT)\\n\",\n",
    "    \"print('EXP_DIR      :', EXP_DIR, '   exists:', EXP_DIR.exists())\\n\",\n",
    "    \"print('RT_DIR       :', RT_DIR,  '   exists:', RT_DIR.exists())\\n\",\n",
    "    \"print('THESIS_DIR   :', THESIS_DIR)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### Executive summary — selected runtime candidate\"\n",
    "   ]\n",
