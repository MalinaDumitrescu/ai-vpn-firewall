    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# All values are read from artifact CSVs / JSON — nothing is invented.\\n\",\n",
    "    \"_SELECTED      = 'unified_relative_shape_v2__lgbm'\\n\",\n",
    "    \"_FAMILY        = 'unified_relative_shape_v2'\\n\",\n",
    "    \"_N_FEATURES    = 12\\n\",\n",
    "    \"_RUNTIME_PATH  = (RT_DIR / 'runtime_models' / _SELECTED).relative_to(PROJECT_ROOT)\\n\",\n",
    "    \"_cmp = pd.read_csv(EXP_DIR / 'model_comparison.csv').set_index('model_id')\\n\",\n",
    "    \"_row = _cmp.loc[_SELECTED]\\n\",\n",
    "    \"_metrics = {\\n\",\n",
    "    \"    'final selected model':    _SELECTED,\\n\",\n",
    "    \"    'feature family':          _FAMILY,\\n\",\n",
    "    \"    'number of features':      _N_FEATURES,\\n\",\n",
    "    \"    'Test AUC':                round(float(_row['test_auc']), 4),\\n\",\n",
    "    \"    'LODO-min AUC':            round(float(_row['lodo_min_auc']), 4),\\n\",\n",
    "    \"    'Domain AUC':              round(float(_row['domain_auc']), 4),\\n\",\n",
    "    \"    'ECE':                     round(float(_row['test_ece']), 4),\\n\",\n",
    "    \"    'Recall':                  round(float(_row['test_recall']), 4),\\n\",\n",
    "    \"    'FPR':                     round(float(_row['test_fpr']), 4),\\n\",\n",
    "    \"    'Deployment score':        round(float(_row['deployment_score']), 4),\\n\",\n",
    "    \"    'Runtime bundle path':     str(_RUNTIME_PATH).replace('\\\\\\\\\\\\\\\\', '/'),\\n\",\n",
    "    \"}\\n\",\n",
    "    \"display(pd.DataFrame(list(_metrics.items()), columns=['property', 'value']))\\n\",\n",
    "    \"display(Markdown(\\n\",\n",
    "    \"    '**Final interpretation.**  This model is selected because it has a cleaner runtime '\\n\",\n",
    "    \"    'feature contract, lower dataset fingerprinting than the legacy full-canonical model, '\\n\",\n",
    "    \"    'slightly better LODO-min performance, and a more defensible deployment story. '\\n\",\n",
    "    \"    '**It is not production-ready.**'\\n\",\n",
    "    \"))\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Read the selected model from recommended_models.json\\n\",\n",
    "    \"rec_path = EXP_DIR / 'recommended_models.json'\\n\",\n",
    "    \"if rec_path.exists():\\n\",\n",
    "    \"    rec = json.loads(rec_path.read_text(encoding='utf-8'))\\n\",\n",
    "    \"    display(Markdown('### Recommended models (from `recommended_models.json`)'))\\n\",\n",
    "    \"    rows = []\\n\",\n",
    "    \"    for role, payload in rec.items():\\n\",\n",
    "    \"        if isinstance(payload, dict):\\n\",\n",
    "    \"            rows.append({\\n\",\n",
    "    \"                'role': role,\\n\",\n",
    "    \"                'model_id': payload.get('model_id') or payload.get('name') or '',\\n\",\n",
    "    \"                'deploy_score': payload.get('deployment_score', payload.get('score', '')),\\n\",\n",
    "    \"                'test_auc': payload.get('test_auc', ''),\\n\",\n",
    "    \"                'lodo_min_auc': payload.get('lodo_min_auc', ''),\\n\",\n",
    "    \"                'domain_auc': payload.get('domain_auc', ''),\\n\",\n",
    "    \"            })\\n\",\n",
    "    \"    rec_df = pd.DataFrame(rows)\\n\",\n",
    "    \"    display(rec_df)\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print('MISSING: recommended_models.json')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## B. Motivation for a unified feature contract\\n\",\n",
    "    \"\\n\",\n",
    "    \"Earlier experiments (`full_canonical__lgbm`, `robust9_firewall`, `balanced_bagging_*`) showed strong pooled AUC\\n\",\n",
    "    \"(~0.999) but a **dataset domain classifier could perfectly identify which dataset a flow came from**\\n\",\n",
    "    \"(domain AUC = 1.0). Forensic auditing revealed that this was partly caused by\\n\",\n",
    "    \"**inconsistent feature definitions across datasets**:\\n\",\n",
    "    \"\\n\",\n",
    "    \"| Feature | ISCX formula | VNAT formula | USBVPN / live formula |\\n\",\n",
    "    \"|---|---|---|---|\\n\",\n",
    "    \"| `direction_balance_bytes`   | `fwd / (rev + eps)` | `A / (A+B+eps)` | `(A-B) / (A+B+eps)` |\\n\",\n",
    "    \"| `direction_balance_packets` | `fwd / (rev + eps)` | `A / (A+B+eps)` | `(A-B) / (A+B+eps)` |\\n\",\n",
    "    \"| `dispersion_symmetry`       | legacy variant      | legacy variant   | clipped symmetric form  |\\n\",\n",
    "    \"\\n\",\n",
    "    \"The `unified_feature_contract_v2` experiment fixes this by enforcing **one canonical formula per feature**\\n\",\n",
    "    \"across all 3 datasets and the live extractor (see `unified_formula_report.md`).\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Show the unified formula report (head)\\n\",\n",
    "    \"ufr = EXP_DIR / 'unified_formula_report.md'\\n\",\n",
    "    \"if ufr.exists():\\n\",\n",
    "    \"    display(Markdown(ufr.read_text(encoding='utf-8')))\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print('MISSING: unified_formula_report.md')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## C. Final unified feature family\\n\",\n",
    "    \"\\n\",\n",
    "    \"The recommended runtime model uses the `unified_relative_shape_v2` family — 12 ratio/relative features that\\n\",\n",
    "    \"should generalise across datasets and remain meaningful at live-extraction time.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"fam_path = EXP_DIR / 'feature_families' / 'unified_relative_shape_v2.json'\\n\",\n",
    "    \"if fam_path.exists():\\n\",\n",
    "    \"    fam = json.loads(fam_path.read_text(encoding='utf-8'))\\n\",\n",
    "    \"    display(Markdown(f\\\"**Family:** `unified_relative_shape_v2`  \\\\n**Feature count:** {len(fam.get('features', []))}\\\"))\\n\",\n",
    "    \"    display(pd.DataFrame({'feature': fam.get('features', [])}))\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print('MISSING:', fam_path)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Selected model feature_order (authoritative)\\n\",\n",
    "    \"fo = RT_DIR / 'runtime_models' / 'unified_relative_shape_v2__lgbm' / 'feature_order.json'\\n\",\n",
    "    \"if fo.exists():\\n\",\n",
    "    \"    fo_obj = json.loads(fo.read_text(encoding='utf-8'))\\n\",\n",
    "    \"    feats = fo_obj if isinstance(fo_obj, list) else fo_obj.get('feature_order', fo_obj.get('features', []))\\n\",\n",
    "    \"    display(Markdown(f\\\"### Runtime `feature_order.json` ({len(feats)} features)\\\"))\\n\",\n",
    "    \"    display(pd.DataFrame({'idx': range(len(feats)), 'feature': feats}))\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Thresholds used by the runtime model\\n\",\n",
    "    \"thr_path = RT_DIR / 'runtime_models' / 'unified_relative_shape_v2__lgbm' / 'thresholds.json'\\n\",\n",
    "    \"if thr_path.exists():\\n\",\n",
    "    \"    thr = json.loads(thr_path.read_text(encoding='utf-8'))\\n\",\n",
    "    \"    display(Markdown('### Runtime thresholds (do **not** modify)'))\\n\",\n",
    "    \"    display(pd.DataFrame([thr]))\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print('MISSING:', thr_path)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### C.1 Runtime feature-order verification\\n\",\n",
    "    \"\\n\",\n",
    "    \"We verify that the runtime `feature_order.json` for `unified_relative_shape_v2__lgbm` contains **exactly** the 12 expected features, in the expected order, with no extras.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"EXPECTED_12 = [\\n\",\n",
    "    \"    'sz_cv','sz_iqr','sz_qratio','sz_median_to_mean',\\n\",\n",
    "    \"    'sz_p25_median_ratio','sz_p75_median_ratio','sz_iqr_norm_median',\\n\",\n",
    "    \"    'iat_cv','iat_iqr',\\n\",\n",
    "    \"    'direction_balance_bytes','direction_balance_packets','dispersion_symmetry',\\n\",\n",
    "    \"]\\n\",\n",
    "    \"rt_fo = RT_DIR / 'runtime_models' / 'unified_relative_shape_v2__lgbm' / 'feature_order.json'\\n\",\n",
    "    \"rt_obj = json.loads(rt_fo.read_text(encoding='utf-8'))\\n\",\n",
    "    \"rt_features = rt_obj['features'] if isinstance(rt_obj, dict) else rt_obj\\n\",\n",
    "    \"\\n\",\n",
    "    \"missing = [f for f in EXPECTED_12 if f not in rt_features]\\n\",\n",
    "    \"extra   = [f for f in rt_features  if f not in EXPECTED_12]\\n\",\n",
    "    \"order_ok = (rt_features == EXPECTED_12)\\n\",\n",
    "    \"\\n\",\n",
    "    \"verif = pd.DataFrame([\\n\",\n",
    "    \"    {'check': 'runtime file present',          'pass': rt_fo.exists()},\\n\",\n",
    "    \"    {'check': 'feature count == 12',           'pass': len(rt_features) == 12},\\n\",\n",
    "    \"    {'check': 'no expected feature missing',   'pass': len(missing) == 0, 'detail': missing or 'none'},\\n\",\n",
    "    \"    {'check': 'no unexpected extra feature',   'pass': len(extra) == 0,   'detail': extra or 'none'},\\n\",\n",
    "    \"    {'check': 'order matches expected',        'pass': order_ok},\\n\",\n",
    "    \"])\\n\",\n",
    "    \"display(Markdown(f'**Runtime feature_order path:** `{rt_fo.relative_to(PROJECT_ROOT)}`'))\\n\",\n",
    "    \"display(verif)\\n\",\n",
    "    \"assert not missing and not extra and order_ok, 'Runtime feature_order does not match the expected 12-feature contract'\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### C.2 Feature groups\\n\",\n",
    "    \"\\n\",\n",
    "    \"Loaded from `thesis_exports/unified_relative_shape_v2_features.csv` (built by\\n\",\n",
    "    \"`scripts/build_thesis_feature_tables.py`).\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"g_csv = THESIS_DIR / 'unified_relative_shape_v2_features.csv'\\n\",\n",
    "    \"if g_csv.exists():\\n\",\n",
    "    \"    groups_df = pd.read_csv(g_csv)\\n\",\n",
    "    \"    display(groups_df)\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print('MISSING:', g_csv, '— run scripts/build_thesis_feature_tables.py first')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### C.3 Feature contract (formulas + raw inputs)\\n\",\n",
    "    \"\\n\",\n",
    "    \"Loaded from `thesis_exports/unified_relative_shape_v2_feature_contract.csv`.\\n\",\n",
    "    \"Formulas are extracted from the canonical extractor\\n\",\n",
    "    \"`src/features/unified_extractor.py` (`extractor_version = unified_v2.0`, `eps = 1e-6`).\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"c_csv = THESIS_DIR / 'unified_relative_shape_v2_feature_contract.csv'\\n\",\n",
    "    \"if c_csv.exists():\\n\",\n",
    "    \"    contract_df = pd.read_csv(c_csv)\\n\",\n",
    "    \"    pd.set_option('display.max_colwidth', None)\\n\",\n",
    "    \"    display(contract_df)\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print('MISSING:', c_csv, '— run scripts/build_thesis_feature_tables.py first')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### C.4 Interpretation\\n\",\n",
    "    \"\\n\",\n",
    "    \"- The `unified_relative_shape_v2` family uses **relative / ratio-style descriptors** of packet-size and inter-arrival-time distributions, together with sign-aware **direction-balance** features. Only two features (`sz_iqr`, `iat_iqr`) carry absolute magnitude; the rest are scale-invariant ratios.\\n\",\n",
    "    \"- This design **avoids relying solely on absolute scale**, which previous audits showed to be a major source of dataset-specific fingerprinting (e.g. ISCX has very different absolute packet-size and IAT distributions than VNAT and USBVPN).\\n\",\n",
    "    \"- It is **intentionally compatible with live runtime extraction**: all 12 features can be computed from per-flow `(timestamps, sizes, directions)` arrays alone, with no need for protocol parsing, payload inspection, or session-level aggregation.\\n\",\n",
    "    \"- It **does not eliminate dataset shift.** Domain-classifier AUC dropped from `1.0000` on the legacy `full_canonical` set to `≈ 0.959` here — better, but still well above chance. Production deployment must still rely on calibration and threshold review, not on the assumption that the model has learned a domain-invariant representation.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### C.5 Feature-group composition figure\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"fig_groups = THESIS_DIR / 'fig_unified_feature_groups.png'\\n\",\n",
    "    \"if fig_groups.exists():\\n\",\n",
    "    \"    display(Image(filename=str(fig_groups)))\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print('MISSING:', fig_groups, '— run scripts/build_thesis_feature_tables.py first')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## D. Model comparison with legacy baselines\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"mc_path = EXP_DIR / 'model_comparison.csv'\\n\",\n",
    "    \"if mc_path.exists():\\n\",\n",
    "    \"    mc = pd.read_csv(mc_path)\\n\",\n",
    "    \"    # Try to sort by deployment_score if present\\n\",\n",
    "    \"    sort_col = next((c for c in ['deployment_score','deploy_score','score'] if c in mc.columns), None)\\n\",\n",
    "    \"    if sort_col:\\n\",\n",
    "    \"        mc = mc.sort_values(sort_col, ascending=False)\\n\",\n",
    "    \"    display(Markdown(f'### `model_comparison.csv` — {len(mc)} models'))\\n\",\n",
    "    \"    display(mc.head(35))\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print('MISSING: model_comparison.csv')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# LODO + domain fingerprint + calibration summaries\\n\",\n",
    "    \"for name in ['lodo_results.csv', 'domain_fingerprint_results.csv', 'calibration_results.csv', 'live_pcap_results.csv', 'anti_fingerprint_feature_scores.csv']:\\n\",\n",
    "    \"    p = EXP_DIR / name\\n\",\n",
    "    \"    display(Markdown(f'### `{name}`'))\\n\",\n",
    "    \"    if p.exists():\\n\",\n",
    "    \"        try:\\n\",\n",
    "    \"            display(pd.read_csv(p).head(20))\\n\",\n",
    "    \"        except Exception as e:\\n\",\n",
    "    \"            display(Markdown(f'_could not read: {e}_'))\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        display(Markdown('_MISSING_'))\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### D.1 Final vs. legacy thesis comparison table\\n\",\n",
    "    \"\\n\",\n",
    "    \"Loaded from `thesis_exports/final_vs_legacy_model_comparison.csv` (built by\\n\",\n",
    "    \"`scripts/build_thesis_model_comparison.py`). All values are read directly from\\n\",\n",
    "    \"`model_comparison.csv` in `artifacts/unified_feature_contract_v2/` and\\n\",\n",
    "    \"`artifacts/final_transfer/`; nothing is invented.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"cmp_csv = THESIS_DIR / 'final_vs_legacy_model_comparison.csv'\\n\",\n",
    "    \"if cmp_csv.exists():\\n\",\n",
    "    \"    cmp_df = pd.read_csv(cmp_csv)\\n\",\n",
    "    \"    pd.set_option('display.max_colwidth', None)\\n\",\n",
