    "    \"import math\\n\",\n",
    "    \"_expected = {\\n\",\n",
    "    \"    'test_auc': 0.9826, 'lodo_min_auc': 0.6366, 'domain_auc': 0.9591,\\n\",\n",
    "    \"    'ece': 0.2988, 'recall': 0.8930, 'fpr': 0.0759, 'deployment_score': 0.4691,\\n\",\n",
    "    \"}\\n\",\n",
    "    \"_sel = cmp_df[cmp_df['model_id'] == 'unified_relative_shape_v2__lgbm']\\n\",\n",
    "    \"if _sel.empty:\\n\",\n",
    "    \"    display(Markdown('**MISSING:** selected model row not in comparison table.'))\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    _sel = _sel.iloc[0]\\n\",\n",
    "    \"    _vrows = []\\n\",\n",
    "    \"    _allok = True\\n\",\n",
    "    \"    for k, want in _expected.items():\\n\",\n",
    "    \"        got = float(_sel[k])\\n\",\n",
    "    \"        ok  = abs(got - want) < 5e-4\\n\",\n",
    "    \"        _allok &= ok\\n\",\n",
    "    \"        _vrows.append({'metric': k, 'spec': want, 'artifact': round(got, 6), 'match': 'OK' if ok else 'MISMATCH'})\\n\",\n",
