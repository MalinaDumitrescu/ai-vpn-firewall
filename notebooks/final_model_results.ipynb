   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# Final Transfer-Aware Model Comparison\\n\",\n",
    "    \"\\n\",\n",
    "    \"This notebook visualizes the artifacts produced by\\n\",\n",
    "    \"`scripts/final_transfer_experiment.py`.\\n\",\n",
    "    \"\\n\",\n",
    "    \"It **does not retrain** any model — it only reads CSV / JSON outputs from\\n\",\n",
    "    \"`artifacts/final_transfer/`.\\n\",\n",
    "    \"\\n\",\n",
    "    \"Outputs visualized:\\n\",\n",
    "    \"\\n\",\n",
    "    \"1. Ranked model comparison table (by `final_score`)\\n\",\n",
    "    \"2. Pooled AUC comparison\\n\",\n",
    "    \"3. LODO AUC per dataset\\n\",\n",
    "    \"4. LODO_min ranking\\n\",\n",
    "    \"5. Domain (fingerprint) AUC comparison (lower is better)\\n\",\n",
    "    \"6. VPN AUC vs Domain AUC scatter\\n\",\n",
    "    \"7. Calibration curves\\n\",\n",
    "    \"8. Confusion matrices grid\\n\",\n",
    "    \"9. Threshold stability\\n\",\n",
    "    \"10. Anti-fingerprint feature importance\\n\",\n",
    "    \"11. Final recommendation\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"import json\\n\",\n",
    "    \"\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import seaborn as sns\\n\",\n",
    "    \"\\n\",\n",
    "    \"sns.set_theme(style='whitegrid', context='notebook')\\n\",\n",
    "    \"plt.rcParams['figure.dpi'] = 110\\n\",\n",
    "    \"\\n\",\n",
    "    \"ROOT = Path('..').resolve()\\n\",\n",
    "    \"ART = ROOT / 'artifacts' / 'final_transfer'\\n\",\n",
    "    \"print('Artifact root:', ART, '->', 'EXISTS' if ART.exists() else 'MISSING')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\"## 1. Ranked model comparison\"]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"comp_path = ART / 'model_comparison.csv'\\n\",\n",
    "    \"if not comp_path.exists():\\n\",\n",
    "    \"    print(f'WARNING: {comp_path} not found - run scripts/final_transfer_experiment.py first.')\\n\",\n",
    "    \"    comp = pd.DataFrame()\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    comp = pd.read_csv(comp_path).sort_values('final_score', ascending=False).reset_index(drop=True)\\n\",\n",
    "    \"    display_cols = ['model_id','feature_family','family','n_features',\\n\",\n",
    "    \"                    'pooled_auc','session_auc','lodo_min_auc','lodo_mean_auc',\\n\",\n",
    "    \"                    'domain_auc','fpr','ece','threshold_instability','runtime_compatible',\\n\",\n",
    "    \"                    'final_score']\\n\",\n",
    "    \"    comp[display_cols].round(4).style.background_gradient(subset=['final_score','pooled_auc','lodo_min_auc'], cmap='RdYlGn')\\n\",\n",
    "    \"comp.head(15).round(4)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\"## 2. Pooled AUC per model\"]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"if comp.empty:\\n\",\n",
    "    \"    print('no data')\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    fig, ax = plt.subplots(figsize=(10, max(4, 0.3*len(comp))))\\n\",\n",
    "    \"    d = comp.sort_values('pooled_auc')\\n\",\n",
    "    \"    bars = ax.barh(d['model_id'], d['pooled_auc'], color=sns.color_palette('viridis', len(d)))\\n\",\n",
    "    \"    ax.axvline(0.5, ls='--', c='grey', label='chance')\\n\",\n",
    "    \"    ax.set_xlabel('pooled flow AUC')\\n\",\n",
    "    \"    ax.set_title('Pooled flow-level AUC per model')\\n\",\n",
    "    \"    ax.set_xlim(0.4, 1.01)\\n\",\n",
    "    \"    plt.tight_layout(); plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\"## 3. LODO AUC per held-out dataset\"]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"if comp.empty:\\n\",\n",
    "    \"    print('no data')\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    lodo_cols = ['lodo_iscx_auc','lodo_usbvpn_auc','lodo_vnat_auc']\\n\",\n",
    "    \"    d = (comp[['model_id'] + lodo_cols].dropna(subset=lodo_cols, how='all')\\n\",\n",
    "    \"         .sort_values('model_id'))\\n\",\n",
    "    \"    if d.empty:\\n\",\n",
    "    \"        print('No LODO results (probably --quick run).')\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        d_m = d.melt(id_vars='model_id', value_vars=lodo_cols, var_name='dataset', value_name='auc')\\n\",\n",
    "    \"        d_m['dataset'] = d_m['dataset'].str.replace('lodo_','').str.replace('_auc','')\\n\",\n",
    "    \"        fig, ax = plt.subplots(figsize=(11, max(4, 0.35*len(d))))\\n\",\n",
    "    \"        sns.barplot(data=d_m, y='model_id', x='auc', hue='dataset', ax=ax)\\n\",\n",
    "    \"        ax.set_xlabel('LODO AUC (held-out test split)')\\n\",\n",
    "    \"        ax.set_title('Per-dataset Leave-One-Domain-Out AUC')\\n\",\n",
    "    \"        ax.axvline(0.5, ls='--', c='grey')\\n\",\n",
    "    \"        ax.set_xlim(0.0, 1.01)\\n\",\n",
    "    \"        plt.tight_layout(); plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\"## 4. LODO_min ranking (worst-case transfer performance)\"]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"if comp.empty or comp['lodo_min_auc'].isna().all():\\n\",\n",
    "    \"    print('No LODO results.')\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    d = comp.dropna(subset=['lodo_min_auc']).sort_values('lodo_min_auc')\\n\",\n",
    "    \"    fig, ax = plt.subplots(figsize=(10, max(4, 0.3*len(d))))\\n\",\n",
    "    \"    ax.barh(d['model_id'], d['lodo_min_auc'], color=sns.color_palette('crest', len(d)))\\n\",\n",
    "    \"    ax.axvline(0.5, ls='--', c='grey')\\n\",\n",
    "    \"    ax.set_xlabel('LODO_min AUC (worst held-out dataset)')\\n\",\n",
    "    \"    ax.set_title('Worst-case transfer AUC across LODO splits')\\n\",\n",
    "    \"    plt.tight_layout(); plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\"## 5. Domain (fingerprint) AUC — lower is better\"]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"if comp.empty:\\n\",\n",
    "    \"    print('no data')\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    d = comp.dropna(subset=['domain_auc']).sort_values('domain_auc')\\n\",\n",
    "    \"    fig, ax = plt.subplots(figsize=(10, max(4, 0.3*len(d))))\\n\",\n",
    "    \"    ax.barh(d['model_id'], d['domain_auc'], color=sns.color_palette('rocket_r', len(d)))\\n\",\n",
    "    \"    ax.axvline(0.5, ls='--', c='grey', label='chance')\\n\",\n",
    "    \"    ax.set_xlabel('Macro-AUC of dataset classifier on this feature subspace')\\n\",\n",
    "    \"    ax.set_title('Dataset fingerprint AUC per model (lower = harder to identify dataset)')\\n\",\n",
    "    \"    ax.legend()\\n\",\n",
    "    \"    plt.tight_layout(); plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\"## 6. VPN AUC vs Domain AUC scatter (the trade-off)\"]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"if comp.empty:\\n\",\n",
    "    \"    print('no data')\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    fig, ax = plt.subplots(figsize=(9, 7))\\n\",\n",
    "    \"    sns.scatterplot(data=comp, x='domain_auc', y='pooled_auc', hue='feature_family',\\n\",\n",
    "    \"                    style='family', s=110, ax=ax)\\n\",\n",
    "    \"    for _, r in comp.iterrows():\\n\",\n",
    "    \"        ax.annotate(r['model_id'], (r['domain_auc'], r['pooled_auc']),\\n\",\n",
    "    \"                    fontsize=7, alpha=0.7,\\n\",\n",
    "    \"                    xytext=(3, 3), textcoords='offset points')\\n\",\n",
    "    \"    ax.axvline(0.5, ls=':', c='grey'); ax.axhline(0.95, ls=':', c='grey')\\n\",\n",
    "    \"    ax.set_xlabel('Domain (dataset) AUC — lower is better')\\n\",\n",
    "    \"    ax.set_ylabel('Pooled VPN AUC — higher is better')\\n\",\n",
    "    \"    ax.set_title('VPN detection vs dataset-fingerprint trade-off')\\n\",\n",
    "    \"    ax.legend(bbox_to_anchor=(1.02, 1), loc='upper left', fontsize=8)\\n\",\n",
    "    \"    plt.tight_layout(); plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\"## 7. Calibration curves (validation set, top-4 models)\"]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"from sklearn.calibration import calibration_curve\\n\",\n",
    "    \"if comp.empty:\\n\",\n",
    "    \"    print('no data')\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    top = comp.head(4)['model_id'].tolist()\\n\",\n",
    "    \"    fig, ax = plt.subplots(figsize=(7, 6))\\n\",\n",
    "    \"    for mid in top:\\n\",\n",
    "    \"        f = ART / 'models' / mid / 'val_predictions.csv'\\n\",\n",
    "    \"        if not f.exists():\\n\",\n",
    "    \"            print(f'(missing) {f}')\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"        d = pd.read_csv(f)\\n\",\n",
    "    \"        if 'prob' not in d.columns and 'prob_iso' in d.columns:\\n\",\n",
    "    \"            d['prob'] = d['prob_iso']\\n\",\n",
    "    \"        try:\\n\",\n",
    "    \"            frac_pos, mean_pred = calibration_curve(d['label'], d['prob'], n_bins=12, strategy='quantile')\\n\",\n",
    "    \"            ax.plot(mean_pred, frac_pos, marker='o', label=mid)\\n\",\n",
    "    \"        except Exception as e:\\n\",\n",
    "    \"            print(f'calib failed for {mid}: {e}')\\n\",\n",
    "    \"    ax.plot([0, 1], [0, 1], 'k--', alpha=0.5, label='perfect')\\n\",\n",
    "    \"    ax.set_xlabel('Mean predicted probability'); ax.set_ylabel('Empirical positive rate')\\n\",\n",
    "    \"    ax.set_title('Reliability diagrams (top-4 by final_score)')\\n\",\n",
    "    \"    ax.legend(fontsize=8)\\n\",\n",
    "    \"    plt.tight_layout(); plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\"## 8. Confusion matrices (top-4 by final_score)\"]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"if comp.empty:\\n\",\n",
    "    \"    print('no data')\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    top = comp.head(4).to_dict('records')\\n\",\n",
    "    \"    fig, axs = plt.subplots(2, 2, figsize=(9, 9))\\n\",\n",
    "    \"    for ax, r in zip(axs.flat, top):\\n\",\n",
    "    \"        cm = np.array([[r['tn'], r['fp']], [r['fn'], r['tp']]])\\n\",\n",
    "    \"        sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', cbar=False, ax=ax)\\n\",\n",
    "    \"        ax.set_xticklabels(['pred 0','pred 1']); ax.set_yticklabels(['true 0','true 1'])\\n\",\n",
    "    \"        ax.set_title(f\\\"{r['model_id']}\\\\nrec={r['recall']:.3f}  fpr={r['fpr']:.3f}\\\")\\n\",\n",
    "    \"    plt.tight_layout(); plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\"## 9. Threshold stability (per feature family)\"]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"if comp.empty:\\n\",\n",
    "    \"    print('no data')\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    fig, ax = plt.subplots(figsize=(9, 5))\\n\",\n",
    "    \"    d = comp.groupby('feature_family')['threshold_instability'].first().reset_index().sort_values('threshold_instability')\\n\",\n",
    "    \"    sns.barplot(data=d, x='feature_family', y='threshold_instability', ax=ax, palette='magma')\\n\",\n",
    "    \"    ax.set_ylabel('std(threshold) across 3 seeds at FPR=0.01 (lower=more stable)')\\n\",\n",
    "    \"    ax.set_title('Threshold stability by feature family')\\n\",\n",
    "    \"    plt.xticks(rotation=20, ha='right')\\n\",\n",
    "    \"    plt.tight_layout(); plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\"## 10. Anti-fingerprint feature importance\"]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"afs_path = ART / 'anti_fingerprint_scores.csv'\\n\",\n",
    "    \"if not afs_path.exists():\\n\",\n",
    "    \"    print(f'WARNING: {afs_path} missing')\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    afs = pd.read_csv(afs_path)\\n\",\n",
    "    \"    top = afs.head(20)\\n\",\n",
    "    \"    fig, ax = plt.subplots(figsize=(10, 7))\\n\",\n",
    "    \"    sns.barplot(data=top, y='feature', x='feature_score', palette='viridis', ax=ax)\\n\",\n",
    "    \"    ax.set_title('Top-20 features by anti-fingerprint score (VPN - lambda*domain - mu*instability - nu*construction)')\\n\",\n",
    "    \"    plt.tight_layout(); plt.show()\\n\",\n",
    "    \"    print(afs.head(15).round(4))\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\"## 11. CORAL baseline\"]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"coral_path = ART / 'coral_results.csv'\\n\",\n",
    "    \"if not coral_path.exists():\\n\",\n",
    "    \"    print('CORAL results not available')\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    cr = pd.read_csv(coral_path)\\n\",\n",
    "    \"    cr['pair'] = cr['src'] + '->' + cr['tgt']\\n\",\n",
    "    \"    m = cr.melt(id_vars='pair', value_vars=['source_only_auc','coral_auc'],\\n\",\n",
    "    \"                var_name='method', value_name='auc')\\n\",\n",
    "    \"    fig, ax = plt.subplots(figsize=(9, 5))\\n\",\n",
    "    \"    sns.barplot(data=m, x='pair', y='auc', hue='method', ax=ax)\\n\",\n",
    "    \"    ax.set_title('Source-only vs CORAL transfer AUC'); ax.axhline(0.5, ls='--', c='grey')\\n\",\n",
    "    \"    plt.xticks(rotation=20, ha='right'); plt.tight_layout(); plt.show()\\n\",\n",
    "    \"    print(cr.round(4))\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\"## 12. Final recommendation\"]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"rec_path = ART / 'recommended_models.json'\\n\",\n",
    "    \"if not rec_path.exists():\\n\",\n",
    "    \"    print(f'WARNING: {rec_path} missing')\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    rec = json.loads(rec_path.read_text(encoding='utf-8'))\\n\",\n",
    "    \"    rows = []\\n\",\n",
    "    \"    for tag, info in rec.items():\\n\",\n",
    "    \"        rows.append({\\n\",\n",
    "    \"            'category': tag,\\n\",\n",
    "    \"            'model_id': info.get('model_id'),\\n\",\n",
    "    \"            'feature_family': info.get('feature_family'),\\n\",\n",
    "    \"            'pooled_auc': round(float(info.get('pooled_auc', 0.0)), 4),\\n\",\n",
    "    \"            'lodo_min_auc': round(float(info.get('lodo_min_auc', 0.0) or 0.0), 4),\\n\",\n",
    "    \"            'domain_auc': round(float(info.get('domain_auc', 0.0) or 0.0), 4),\\n\",\n",
    "    \"            'fpr': round(float(info.get('fpr', 0.0)), 4),\\n\",\n",
    "    \"            'ece': round(float(info.get('ece', 0.0)), 4),\\n\",\n",
    "    \"            'final_score': round(float(info.get('final_score', 0.0)), 4),\\n\",\n",
    "    \"            'runtime_compatible': info.get('runtime_compatible'),\\n\",\n",
    "    \"        })\\n\",\n",
    "    \"    rec_df = pd.DataFrame(rows)\\n\",\n",
    "    \"    print(rec_df.to_string(index=False))\\n\",\n",
    "    \"    if 'recommended_firewall' in rec:\\n\",\n",
    "    \"        rf = rec['recommended_firewall']\\n\",\n",
    "    \"        print('\\\\n*** RECOMMENDED FIREWALL PROTOTYPE ***')\\n\",\n",
    "    \"        print(f\\\"  model_id        : {rf.get('model_id')}\\\")\\n\",\n",
    "    \"        print(f\\\"  feature family  : {rf.get('feature_family')} ({rf.get('n_features')} features)\\\")\\n\",\n",
    "    \"        print(f\\\"  pooled AUC      : {rf.get('pooled_auc'):.4f}\\\")\\n\",\n",
    "    \"        print(f\\\"  LODO min/mean   : {rf.get('lodo_min_auc')!s} / {rf.get('lodo_mean_auc')!s}\\\")\\n\",\n",
    "    \"        print(f\\\"  domain AUC      : {rf.get('domain_auc')!s}  (lower = less fingerprint)\\\")\\n\",\n",
    "    \"        print(f\\\"  fpr / recall    : {rf.get('fpr'):.4f} / {rf.get('recall'):.4f}\\\")\\n\",\n",
    "    \"        print(f\\\"  ECE             : {rf.get('ece'):.4f}\\\")\\n\",\n",
    "    \"        print(f\\\"  runtime compat. : {rf.get('runtime_compatible')}\\\")\\n\",\n",
    "    \"        print(f\\\"  final_score     : {rf.get('final_score'):.4f}\\\")\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
