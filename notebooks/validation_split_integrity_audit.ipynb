   "cell_type": "raw",
   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# Split Integrity Audit Notebook\\n\",\n",
    "    \"This notebook audits split integrity for the CLEAN pipeline.\\n\",\n",
    "    \"It generates figures and summary tables for presentation and CI.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import seaborn as sns\\n\",\n",
    "    \"import json\\n\",\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"# Load features and split manifest\\n\",\n",
    "    \"features = pd.read_parquet('artifacts/clean_pipeline/features.parquet')\\n\",\n",
    "    \"manifest = json.load(open('artifacts/clean_pipeline/clean_split_manifest.json'))\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 1. Split composition per dataset (stacked bar chart)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"fig, ax = plt.subplots(figsize=(8, 5))\\n\",\n",
    "    \"split_counts = features.groupby(['dataset', 'split', 'label']).size().unstack(fill_value=0)\\n\",\n",
    "    \"split_counts = split_counts.rename(columns={0: 'nonVPN', 1: 'VPN'})\\n\",\n",
    "    \"split_counts[['nonVPN', 'VPN']].plot(kind='bar', stacked=True, ax=ax)\\n\",\n",
    "    \"plt.title('Split Composition per Dataset')\\n\",\n",
    "    \"plt.ylabel('Flow count')\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig('figures/validation/split_composition_per_dataset.png')\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 2. Capture size distribution (boxplot/violin plot)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"fig, ax = plt.subplots(figsize=(8, 5))\\n\",\n",
    "    \"cap_sizes = features.groupby(['dataset', 'split', 'capture_id']).size().reset_index(name='n_flows')\\n\",\n",
    "    \"sns.boxplot(data=cap_sizes, x='split', y='n_flows', hue='dataset', ax=ax)\\n\",\n",
    "    \"ax.set_yscale('log')\\n\",\n",
    "    \"plt.title('Capture Size Distribution by Split and Dataset')\\n\",\n",
    "    \"plt.ylabel('Flows per capture (log scale)')\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig('figures/validation/capture_size_distribution.png')\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 3. Split constraint violations by seed (bar/line chart)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# Example: load diagnostics from multiple seeds if available\\n\",\n",
    "    \"import glob\\n\",\n",
    "    \"violation_counts = []\\n\",\n",
    "    \"for path in glob.glob('artifacts/validation/diagnostics_seed_*.json'):\\n\",\n",
    "    \"    with open(path) as f:\\n\",\n",
    "    \"        diag = json.load(f)\\n\",\n",
    "    \"    seed = int(path.split('_')[-1].split('.')[0])\\n\",\n",
    "    \"    n_viol = len(diag.get('constraint_violations', []))\\n\",\n",
    "    \"    violation_counts.append({'seed': seed, 'violations': n_viol})\\n\",\n",
    "    \"if violation_counts:\\n\",\n",
    "    \"    df_viol = pd.DataFrame(violation_counts)\\n\",\n",
    "    \"    fig, ax = plt.subplots(figsize=(8, 4))\\n\",\n",
    "    \"    sns.barplot(data=df_viol, x='seed', y='violations', ax=ax)\\n\",\n",
    "    \"    plt.title('Split Constraint Violations by Seed')\\n\",\n",
    "    \"    plt.ylabel('Number of violations')\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    plt.savefig('figures/validation/split_constraint_violations_by_seed.png')\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print('No diagnostics found for multiple seeds.')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 4. Save split integrity summary (CSV/JSON)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"summary = []\\n\",\n",
    "    \"for ds in manifest['per_dataset_split']:\\n\",\n",
    "    \"    for split, stats in manifest['per_dataset_split'][ds].items():\\n\",\n",
    "    \"        summary.append({\\n\",\n",
    "    \"            'dataset': ds,\\n\",\n",
    "    \"            'split': split,\\n\",\n",
    "    \"            **stats\\n\",\n",
    "    \"        })\\n\",\n",
    "    \"summary_df = pd.DataFrame(summary)\\n\",\n",
    "    \"summary_df.to_csv('artifacts/validation/split_integrity_summary.csv', index=False)\\n\",\n",
    "    \"summary_df.to_json('artifacts/validation/split_integrity_summary.json', orient='records', indent=2)\\n\",\n",
    "    \"summary_df.head()\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
