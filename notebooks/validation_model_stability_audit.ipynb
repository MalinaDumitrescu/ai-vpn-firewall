   "cell_type": "raw",
   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# Model Stability Audit Notebook\\n\",\n",
    "    \"This notebook audits model metric stability, threshold selection, and bootstrap CIs for the CLEAN pipeline.\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import json\\n\",\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"seed_metrics = pd.read_csv('artifacts/validation/model_seed_stability.csv')\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 1. Metric variability across seeds\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"fig, axes = plt.subplots(1, 3, figsize=(12, 4))\\n\",\n",
    "    \"seed_metrics.boxplot(column=['test_auc', 'test_recall', 'test_fpr'], ax=axes[0])\\n\",\n",
    "    \"axes[0].set_title('Test Metrics Variability')\\n\",\n",
    "    \"axes[1].plot(seed_metrics['seed'], seed_metrics['threshold'], marker='o')\\n\",\n",
    "    \"axes[1].set_title('Thresholds Across Seeds')\\n\",\n",
    "    \"axes[1].set_xlabel('Seed')\\n\",\n",
    "    \"axes[1].set_ylabel('Threshold')\\n\",\n",
    "    \"axes[2].boxplot([seed_metrics['test_auc'], seed_metrics['test_recall'], seed_metrics['test_fpr']], labels=['AUC', 'Recall', 'FPR'])\\n\",\n",
    "    \"axes[2].set_title('Metric Distribution')\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig('figures/validation/metric_variability_across_seeds.png')\\n\",\n",
    "    \"plt.show()\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 2. Threshold distribution across seeds\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"plt.figure(figsize=(6, 4))\\n\",\n",
    "    \"seed_metrics['threshold'].plot(kind='hist', bins=10, alpha=0.7)\\n\",\n",
    "    \"plt.title('Threshold Distribution Across Seeds')\\n\",\n",
    "    \"plt.xlabel('Threshold')\\n\",\n",
    "    \"plt.ylabel('Count')\\n\",\n",
    "    \"plt.savefig('figures/validation/threshold_distribution_across_seeds.png')\\n\",\n",
    "    \"plt.show()\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 3. Bootstrap confidence intervals\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"summary = pd.read_csv('artifacts/validation/model_stability_summary.csv')\\n\",\n",
    "    \"metrics = ['auc', 'recall', 'fpr']\\n\",\n",
    "    \"ci_lowers = [summary[f'{m}_ci_lower'][0] for m in metrics]\\n\",\n",
    "    \"ci_uppers = [summary[f'{m}_ci_upper'][0] for m in metrics]\\n\",\n",
    "    \"means = [summary[f'{m}'][0] for m in metrics]\\n\",\n",
    "    \"plt.figure(figsize=(7, 4))\\n\",\n",
    "    \"plt.errorbar(metrics, means, yerr=[np.array(means)-np.array(ci_lowers), np.array(ci_uppers)-np.array(means)], fmt='o', capsize=5)\\n\",\n",
    "    \"plt.title('Bootstrap Confidence Intervals')\\n\",\n",
    "    \"plt.ylabel('Metric value')\\n\",\n",
    "    \"plt.savefig('figures/validation/bootstrap_confidence_intervals.png')\\n\",\n",
    "    \"plt.show()\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 4. Save model stability summary\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"summary.to_json('artifacts/validation/model_stability_summary.json', orient='records', indent=2)\\n\",\n",
    "    \"summary.head()\\n\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
