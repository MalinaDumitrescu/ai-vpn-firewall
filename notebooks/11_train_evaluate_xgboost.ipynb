    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def plot_reliability_curve(y_true, y_prob, n_bins=10, title=\\\"Reliability Diagram\\\"):\\n\",\n",
    "    \"    bins = np.linspace(0.0, 1.0, n_bins + 1)\\n\",\n",
    "    \"    bin_ids = np.digitize(y_prob, bins) - 1\\n\",\n",
    "    \"    bin_ids = np.clip(bin_ids, 0, n_bins - 1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    pred_means = []\\n\",\n",
    "    \"    obs_rates = []\\n\",\n",
    "    \"    counts = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for b in range(n_bins):\\n\",\n",
    "    \"        mask = bin_ids == b\\n\",\n",
    "    \"        if mask.sum() == 0:\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"        pred_means.append(y_prob[mask].mean())\\n\",\n",
    "    \"        obs_rates.append(y_true[mask].mean())\\n\",\n",
    "    \"        counts.append(mask.sum())\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.figure(figsize=(6, 6))\\n\",\n",
    "    \"    plt.plot([0, 1], [0, 1], linestyle=\\\"--\\\")\\n\",\n",
    "    \"    plt.plot(pred_means, obs_rates, marker=\\\"o\\\")\\n\",\n",
    "    \"    plt.xlabel(\\\"Mean predicted probability\\\")\\n\",\n",
    "    \"    plt.ylabel(\\\"Observed positive rate\\\")\\n\",\n",
    "    \"    plt.title(title)\\n\",\n",
    "    \"    plt.grid(True)\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return pd.DataFrame({\\n\",\n",
    "    \"        \\\"bin_pred_mean\\\": pred_means,\\n\",\n",
    "    \"        \\\"bin_obs_rate\\\": obs_rates,\\n\",\n",
    "    \"        \\\"count\\\": counts,\\n\",\n",
    "    \"    })\\n\",\n",
    "    \"\\n\",\n",
    "    \"if \\\"df_preds\\\" in locals():\\n\",\n",
    "    \"    print(\\\"\\\\n--- Reliability Diagram (Test Set) ---\\\")\\n\",\n",
    "    \"    test_preds = df_preds[df_preds[\\\"split\\\"] == \\\"test\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for mode, col in [(\\\"Raw\\\", \\\"prob_raw\\\"), (\\\"Isotonic\\\", \\\"prob_iso\\\"), (\\\"Platt\\\", \\\"prob_platt\\\")]:\\n\",\n",
    "    \"        plot_reliability_curve(\\n\",\n",
    "    \"            test_preds[\\\"label\\\"],\\n\",\n",
    "    \"            test_preds[col],\\n\",\n",
    "    \"            n_bins=10,\\n\",\n",
    "    \"            title=f\\\"Reliability Diagram (Test Set) - {mode}\\\"\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print(\\\"df_preds not found. Run the previous cell to load predictions.\\\")\"\n",
    "   ],\n",
