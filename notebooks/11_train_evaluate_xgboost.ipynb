    "   \"source\": [\n",
    "    \"preds_path = paths.artifacts_dir / \\\"balanced_bagging_xgb\\\" / \\\"predictions.csv\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"if preds_path.exists():\\n\",\n",
    "    \"    df_preds = pd.read_csv(preds_path)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Check for required columns\\n\",\n",
    "    \"    required_cols = [\\\"prob_raw\\\", \\\"prob_iso\\\", \\\"prob_platt\\\"]\\n\",\n",
    "    \"    missing = [c for c in required_cols if c not in df_preds.columns]\\n\",\n",
    "    \"    if missing:\\n\",\n",
    "    \"        raise ValueError(f\\\"Missing probability columns in predictions.csv: {missing}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(\\\"\\\\nPredictions columns:\\\")\\n\",\n",
    "    \"    print(df_preds.columns.tolist())\\n\",\n",
    "    \"\\n\",\n",
    "    \"    from sklearn.metrics import brier_score_loss, log_loss\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(\\\"\\\\n--- RAW vs CALIBRATED COMPARISON (XGBoost) ---\\\")\\n\",\n",
    "    \"    for split_name in [\\\"val\\\", \\\"test\\\"]:\\n\",\n",
    "    \"        sub = df_preds[df_preds[\\\"split\\\"] == split_name].copy()\\n\",\n",
    "    \"        if sub.empty:\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"        y = sub[\\\"label\\\"].astype(int)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        print(f\\\"\\\\n--- SPLIT: {split_name.upper()} ---\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"        stats = []\\n\",\n",
    "    \"        for mode, col in [(\\\"Raw\\\", \\\"prob_raw\\\"), (\\\"Isotonic\\\", \\\"prob_iso\\\"), (\\\"Platt\\\", \\\"prob_platt\\\")]:\\n\",\n",
    "    \"            p = sub[col]\\n\",\n",
    "    \"            auc = roc_auc_score(y, p)\\n\",\n",
    "    \"            ap = average_precision_score(y, p)\\n\",\n",
    "    \"            brier = brier_score_loss(y, p)\\n\",\n",
    "    \"            ll = log_loss(y, np.clip(p, 1e-6, 1 - 1e-6))\\n\",\n",
    "    \"\\n\",\n",
    "    \"            stats.append({\\n\",\n",
    "    \"                \\\"Mode\\\": mode,\\n\",\n",
    "    \"                \\\"AUC\\\": auc,\\n\",\n",
    "    \"                \\\"PR_AUC\\\": ap,\\n\",\n",
    "    \"                \\\"Brier\\\": brier,\\n\",\n",
    "    \"                \\\"LogLoss\\\": ll\\n\",\n",
    "    \"            })\\n\",\n",
    "    \"\\n\",\n",
    "    \"        print(pd.DataFrame(stats).to_string(index=False, float_format=\\\"%.4f\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(\\\"\\\\n--- Generating Plots for XGBoost (Isotonic) ---\\\")\\n\",\n",
    "    \"    plot_roc_curves(df_preds, prob_col=\\\"prob_iso\\\", title=\\\"XGBoost ROC (Balanced Bagging, Isotonic)\\\")\\n\",\n",
    "    \"    plot_pr_curves(df_preds, prob_col=\\\"prob_iso\\\", title=\\\"XGBoost PR (Balanced Bagging, Isotonic)\\\")\\n\",\n",
    "    \"    plot_probability_distributions(df_preds, prob_col=\\\"prob_iso\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Confusion Matrices for Isotonic\\n\",\n",
    "    \"    val_metrics_iso = results.get(\\\"isotonic\\\", {}).get(\\\"val\\\", {})\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def get_thr(metrics_dict, fpr):\\n\",\n",
    "    \"        key = f\\\"fpr_{fpr}\\\"\\n\",\n",
    "    \"        if key in metrics_dict:\\n\",\n",
    "    \"            return metrics_dict[key][\\\"threshold\\\"]\\n\",\n",
    "    \"        return 0.99\\n\",\n",
    "    \"\\n\",\n",
    "    \"    T_BLOCK = get_thr(val_metrics_iso, 0.001)\\n\",\n",
    "    \"    T_MONITOR = get_thr(val_metrics_iso, 0.01)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(\\\"\\\\n--- Confusion Matrices at Policy Thresholds (Test Set, Isotonic) ---\\\")\\n\",\n",
    "    \"    test_preds = df_preds[df_preds[\\\"split\\\"] == \\\"test\\\"].copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plot_confusion_matrices(\\n\",\n",
    "    \"        test_preds,\\n\",\n",
    "    \"        prob_col=\\\"prob_iso\\\",\\n\",\n",
    "    \"        threshold=T_BLOCK,\\n\",\n",
    "    \"        title=f\\\"Confusion Matrix (BLOCK Threshold p >= {T_BLOCK:.4f})\\\"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plot_confusion_matrices(\\n\",\n",
    "    \"        test_preds,\\n\",\n",
    "    \"        prob_col=\\\"prob_iso\\\",\\n\",\n",
