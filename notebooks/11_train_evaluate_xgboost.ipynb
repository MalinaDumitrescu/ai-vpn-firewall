    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def apply_split_lists(df: pd.DataFrame, train_list: Path, val_list: Path, test_list: Path, *, split_col: str = \\\"split\\\") -> pd.DataFrame:\\n\",\n",
    "    \"    splits = load_splits(train_list, val_list, test_list)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    cap_to_split = {}\\n\",\n",
    "    \"    for split_name, caps in splits.items():\\n\",\n",
    "    \"        for cid in caps:\\n\",\n",
    "    \"            cap_to_split[str(cid)] = split_name\\n\",\n",
    "    \"\\n\",\n",
    "    \"    out = df.copy()\\n\",\n",
    "    \"    out[\\\"capture_id\\\"] = out[\\\"capture_id\\\"].astype(str)\\n\",\n",
    "    \"    out[split_col] = out[\\\"capture_id\\\"].map(cap_to_split)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    missing_caps = sorted(out.loc[out[split_col].isna(), \\\"capture_id\\\"].unique().tolist())\\n\",\n",
    "    \"    if missing_caps:\\n\",\n",
    "    \"        raise ValueError(\\n\",\n",
    "    \"            f\\\"Found {len(missing_caps)} captures without split assignment. \\\"\\n\",\n",
    "    \"            f\\\"Examples: {missing_caps[:10]}\\\"\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return out\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def print_split_summary(df: pd.DataFrame, name: str):\\n\",\n",
    "    \"    print(f\\\"\\\\n{name} split counts:\\\")\\n\",\n",
    "    \"    print(df[\\\"split\\\"].value_counts(dropna=False))\\n\",\n",
    "    \"    print(f\\\"\\\\n{name} label by split:\\\")\\n\",\n",
    "    \"    print(pd.crosstab(df[\\\"split\\\"], df[\\\"label\\\"]))\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def print_capture_summary(df: pd.DataFrame, name: str):\\n\",\n",
    "    \"    tmp = (\\n\",\n",
    "    \"        df.groupby([\\\"split\\\", \\\"dataset\\\"])[\\\"capture_id\\\"]\\n\",\n",
    "    \"        .nunique()\\n\",\n",
    "    \"        .unstack(fill_value=0)\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    print(f\\\"\\\\n{name} unique captures by split/dataset:\\\")\\n\",\n",
    "    \"    print(tmp)\"\n",
    "   ],\n",
