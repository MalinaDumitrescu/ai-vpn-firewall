   "metadata": {},
   "cell_type": "raw",
   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# Feature Consistency Audit Notebook\\n\",\n",
    "    \"This notebook audits feature schema, direction-invariance, and formula consistency for the CLEAN pipeline.\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import json\\n\",\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"features = pd.read_parquet('artifacts/clean_pipeline/features.parquet')\\n\",\n",
    "    \"with open('artifacts/clean_pipeline/feature_columns.json') as f:\\n\",\n",
    "    \"    feature_columns = json.load(f)\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 1. Required input schema\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"required = ['flow_id', 'capture_id', 'dataset', 'label', 'timestamps', 'sizes', 'directions']\\n\",\n",
    "    \"print('Required input columns:', required)\\n\",\n",
    "    \"print('Present in features:', all(col in features.columns for col in required))\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 2. Final feature schema\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"print('Model feature columns (from artifact):', feature_columns)\\n\",\n",
    "    \"print('Features DataFrame columns:', list(features.columns))\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 3. Excluded metadata/risky features\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"risky_patterns = ['fwd', 'bwd', 'forward', 'backward', 'src', 'dst', 'client', 'server', 'directional_ratio']\\n\",\n",
    "    \"risky = [f for f in feature_columns if any(p in f.lower() for p in risky_patterns)]\\n\",\n",
    "    \"print('Risky features in model columns:', risky)\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 4. Rate feature formula consistency\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"df = features[features['flow_duration'] > 0].copy()\\n\",\n",
    "    \"recomputed_packet_rate = df['total_packets'] / df['flow_duration']\\n\",\n",
    "    \"recomputed_byte_rate = df['total_bytes'] / df['flow_duration']\\n\",\n",
    "    \"fig, axes = plt.subplots(1, 2, figsize=(10, 5))\\n\",\n",
    "    \"axes[0].scatter(df['packet_rate'], recomputed_packet_rate, alpha=0.3, s=5)\\n\",\n",
    "    \"axes[0].plot([df['packet_rate'].min(), df['packet_rate'].max()], [df['packet_rate'].min(), df['packet_rate'].max()], 'r--')\\n\",\n",
    "    \"axes[0].set_xlabel('Stored packet_rate')\\n\",\n",
    "    \"axes[0].set_ylabel('Recomputed packet_rate')\\n\",\n",
    "    \"axes[0].set_title('Packet Rate Consistency')\\n\",\n",
    "    \"axes[0].set_xscale('log')\\n\",\n",
    "    \"axes[0].set_yscale('log')\\n\",\n",
    "    \"axes[1].scatter(df['byte_rate'], recomputed_byte_rate, alpha=0.3, s=5)\\n\",\n",
    "    \"axes[1].plot([df['byte_rate'].min(), df['byte_rate'].max()], [df['byte_rate'].min(), df['byte_rate'].max()], 'r--')\\n\",\n",
    "    \"axes[1].set_xlabel('Stored byte_rate')\\n\",\n",
    "    \"axes[1].set_ylabel('Recomputed byte_rate')\\n\",\n",
    "    \"axes[1].set_title('Byte Rate Consistency')\\n\",\n",
    "    \"axes[1].set_xscale('log')\\n\",\n",
    "    \"axes[1].set_yscale('log')\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig('figures/validation/rate_feature_formula_consistency.png')\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"max_packet_rate_error = np.max(np.abs(df['packet_rate'] - recomputed_packet_rate))\\n\",\n",
    "    \"max_byte_rate_error = np.max(np.abs(df['byte_rate'] - recomputed_byte_rate))\\n\",\n",
    "    \"print('Max abs error (packet_rate):', max_packet_rate_error)\\n\",\n",
    "    \"print('Max abs error (byte_rate):', max_byte_rate_error)\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 5. Save feature consistency summary\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"summary = [{\\n\",\n",
    "    \"    'check_name': 'rate_formula_consistency',\\n\",\n",
    "    \"    'status': 'PASS' if max_packet_rate_error < 1e-6 and max_byte_rate_error < 1e-6 else 'FAIL',\\n\",\n",
    "    \"    'feature_count': len(feature_columns),\\n\",\n",
    "    \"    'missing_features': [f for f in feature_columns if f not in features.columns],\\n\",\n",
    "    \"    'extra_features': [f for f in features.columns if f not in feature_columns],\\n\",\n",
    "    \"    'max_absolute_formula_error': float(max(max_packet_rate_error, max_byte_rate_error)),\\n\",\n",
    "    \"    'notes': ''\\n\",\n",
    "    \"}]\\n\",\n",
    "    \"pd.DataFrame(summary).to_csv('artifacts/validation/feature_consistency_summary.csv', index=False)\\n\",\n",
    "    \"with open('artifacts/validation/feature_consistency_summary.json', 'w') as f:\\n\",\n",
    "    \"    json.dump(summary, f, indent=2)\\n\",\n",
    "    \"pd.DataFrame(summary)\\n\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
